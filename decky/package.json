  "description": "Share any game, including non-Steam games and emulators, with Steam Remote Play Together from the Steam Deck's Quick Access Menu.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casual-Gamer8001/RemotePlayWhatever.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "remote-play-together"
  ],
  "author": "Casual-Gamer8001 (Remote Play Whatever fork)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Casual-Gamer8001/RemotePlayWhatever/issues"
  },
  "homepage": "https://github.com/Casual-Gamer8001/RemotePlayWhatever/tree/master/decky#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "^2.0.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
